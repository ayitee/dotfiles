{
    "description": "K380s: Fn + Control + Option + Arrows to Move Window Between Displays",
    "manipulators": [
        {
            "description": "Move Window to Left/Previous Display",
            "from": {
                "key_code": "home",
                "modifiers": {
                    "mandatory": ["left_control", "left_option"],
                    "optional": ["caps_lock"]
                }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["fn", "left_control", "left_option"]
                }
            ],
            "type": "basic"
        },
        {
            "description": "Move Window to Right/Next Display",
            "from": {
                "key_code": "end",
                "modifiers": {
                    "mandatory": ["left_control", "left_option"],
                    "optional": ["caps_lock"]
                }
            },
            "to": [
                {
                    "key_code": "right_arrow",
                    "modifiers": ["fn", "left_control", "left_option"]
                }
            ],
            "type": "basic"
        }
    ]
}